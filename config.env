# ============================================================================
# Oracle Cloud Keep-Alive Configuration
# ============================================================================
# Edit these values BEFORE installing to customize behavior
# This file will be copied to /etc/default/oracle-keep-alive on installation
#
# Oracle Cloud reclaims instances idle for 7 days when ALL metrics are:
#   - CPU utilization < 15%
#   - Network utilization < 15%
#   - Memory utilization < 15% (ARM only)
# 
# You only need ONE metric above 15% to stay safe!
# ============================================================================

# ============================================================================
# STRESS TIMING CONFIGURATION
# ============================================================================

# How long to run each stress cycle (seconds)
# Recommended: 30-60 seconds
# Lower = less aggressive, Higher = more consistent metrics
STRESS_DURATION=45

# How long to sleep between stress cycles (seconds)
# Recommended: 300-600 seconds (5-10 minutes)
# Higher = less resource usage, but ensure you still hit 15% average
SLEEP_DURATION=480

# ============================================================================
# CPU STRESS CONFIGURATION
# ============================================================================

# Enable CPU stress (1=enabled, 0=disabled)
# Set to 1 if you want to ensure CPU stays above 15%
STRESS_CPU=1

# Target CPU percentage during active stress period
# Recommended: 20-40% (will average lower due to sleep periods)
# Formula: (STRESS_DURATION / (STRESS_DURATION + SLEEP_DURATION)) * TARGET_CPU_PERCENT = Average CPU
# Example: (45 / (45 + 480)) * 40 = ~3.4% average (too low!)
# Better: Set to 80-100% during stress to get ~7-9% average, or reduce SLEEP_DURATION
TARGET_CPU_PERCENT=95

# CPU stress workers (auto-detected if not set)
# Leave empty for auto-detection based on CPU cores
# Manual override: Set to number of workers (e.g., "2" for 2 workers)
CPU_WORKERS=""

# ============================================================================
# MEMORY STRESS CONFIGURATION  
# ============================================================================

# Enable memory stress (1=enabled, 0=disabled)
# ARM instances: Memory is monitored, set to 1
# x86 instances: Memory not monitored, can set to 0 to save resources
STRESS_MEMORY=1

# Memory to allocate during stress (in MB)
# Recommended: 100-500MB depending on your total RAM
# Don't allocate too much if you're running other services!
MEMORY_STRESS_MB=150

# How long to hold memory allocation (seconds)
# Recommended: 5-15 seconds
MEMORY_HOLD_DURATION=10

# ============================================================================
# NETWORK STRESS CONFIGURATION (GAMING VPN OPTIMIZED)
# ============================================================================

# Enable network stress (1=enabled, 0=disabled)
# Set to 1 to ensure network utilization stays above 15%
STRESS_NETWORK=1

# Network stress mode:
#   "smart"     - Adaptive, gaming-friendly (RECOMMENDED for VPN servers)
#   "minimal"   - Very light, just enough to register activity
#   "moderate"  - Balanced approach
#   "aggressive"- Heavy traffic generation (not recommended for gaming)
NETWORK_STRESS_MODE="smart"

# Smart mode settings (only applies when NETWORK_STRESS_MODE="smart")
# -------------------------
# These settings ensure network activity without interfering with gaming

# Bandwidth limit per stress cycle (in KB/s)
# This prevents the script from saturating your connection
# Recommended: 50-200 KB/s (which is ~0.4-1.6 Mbps)
# This is enough to register activity without affecting gaming
NETWORK_BANDWIDTH_LIMIT_KBS=100

# Use distributed targets to avoid concentrated traffic
# When enabled, spreads requests across multiple providers
NETWORK_USE_DISTRIBUTED_TARGETS=1

# Ping targets (space-separated list of IPs/domains)
# These are pinged periodically to show network activity
# Using diverse providers helps with Oracle's monitoring
NETWORK_PING_TARGETS="8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 208.67.222.222 208.67.220.220"

# Number of pings per target during each stress cycle
# Recommended: 3-10 (low impact on gaming)
NETWORK_PINGS_PER_TARGET=5

# Ping interval (seconds between pings to same target)
# Recommended: 0.2-1.0 (slower = less impact on gaming)
NETWORK_PING_INTERVAL=0.3

# HTTP/HTTPS request targets (space-separated URLs)
# Small HTTP requests to generate traffic
# These are rotated during each cycle
NETWORK_HTTP_TARGETS="http://www.google.com/generate_204 http://detectportal.firefox.com/success.txt http://captive.apple.com/hotspot-detect.html https://www.cloudflare.com/cdn-cgi/trace"

# Number of HTTP requests per stress cycle
# Recommended: 5-20 (each request is small)
NETWORK_HTTP_REQUESTS=10

# HTTP request timeout (seconds)
# Recommended: 2-5 seconds
NETWORK_HTTP_TIMEOUT=3

# Enable background download test (downloads small file to measure bandwidth)
# This helps Oracle see actual data transfer
# File size is limited by NETWORK_BANDWIDTH_LIMIT_KBS
NETWORK_ENABLE_DOWNLOAD_TEST=1

# Download test URL (should be a small, fast file)
# We'll download only part of it based on bandwidth limit
NETWORK_DOWNLOAD_TEST_URL="http://speedtest.ftp.otenet.gr/files/test100k.db"

# Traffic shaping - use tc (traffic control) to prevent burst interference
# This ensures stress traffic doesn't create latency spikes for gaming
# Requires 'tc' command (usually available in iproute2 package)
NETWORK_USE_TRAFFIC_SHAPING=1

# Priority for stress traffic (lower = less priority)
# Gaming traffic will be prioritized over keep-alive traffic
# Range: 0-7, where 7 is lowest priority
NETWORK_TRAFFIC_PRIORITY=7

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log file location
LOG_FILE=/var/log/oracle-keep-alive.log

# Log level (DEBUG, INFO, WARN, ERROR)
# DEBUG: Very verbose, shows all operations
# INFO: Normal operation logs
# WARN: Only warnings and errors
# ERROR: Only errors
LOG_LEVEL=INFO

# Enable detailed stats logging every N cycles
# Set to 0 to disable detailed stats
# Recommended: 10-50 (log stats every 10-50 cycles)
LOG_STATS_EVERY_N_CYCLES=12

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Nice level for stress processes (19 = lowest priority)
# This ensures keep-alive doesn't interfere with your actual services
# Range: 0-19, where 19 is lowest CPU priority
PROCESS_NICE_LEVEL=19

# IO scheduling class (idle, best-effort, realtime)
# idle: Lowest priority, won't interfere with other IO
# best-effort: Normal priority
IO_SCHEDULING_CLASS=idle

# Enable automatic metric verification
# Periodically checks if metrics are above 15% threshold
# If below, increases stress intensity automatically
AUTO_ADJUST_INTENSITY=1

# Metric check interval (in cycles)
# How often to verify metrics are above threshold
# Recommended: 10-20 cycles
METRIC_CHECK_INTERVAL=15

# Failsafe mode - if metrics still below 15% after adjustment
# Switches to more aggressive stress pattern
ENABLE_FAILSAFE_MODE=1

# ============================================================================
# MONITORING INTEGRATION (OPTIONAL)
# ============================================================================

# Enable Prometheus metrics export
# Exposes metrics on http://localhost:9090/metrics
ENABLE_PROMETHEUS_METRICS=0

# Prometheus metrics port
PROMETHEUS_METRICS_PORT=9090

# Enable health check endpoint
# Responds to HTTP requests on specified port for monitoring
ENABLE_HEALTH_CHECK=0

# Health check port
HEALTH_CHECK_PORT=8080

# ============================================================================
# NOTES
# ============================================================================
#
# Gaming VPN Optimization Tips:
# ------------------------------
# 1. Keep SLEEP_DURATION high (300-600s) to minimize interference
# 2. Set NETWORK_STRESS_MODE to "smart" for gaming-friendly behavior
# 3. Use NETWORK_BANDWIDTH_LIMIT_KBS to prevent saturation
# 4. Enable NETWORK_USE_TRAFFIC_SHAPING if available
# 5. Set NETWORK_TRAFFIC_PRIORITY to 7 (lowest)
# 6. Monitor your actual metrics in Oracle Cloud Console
#
# Recommended Settings for Gaming VPN:
# -------------------------------------
# STRESS_DURATION=45
# SLEEP_DURATION=480
# STRESS_CPU=1
# TARGET_CPU_PERCENT=95
# STRESS_MEMORY=1
# STRESS_NETWORK=1
# NETWORK_STRESS_MODE="smart"
# NETWORK_BANDWIDTH_LIMIT_KBS=100
# NETWORK_USE_TRAFFIC_SHAPING=1
#
# This configuration will:
# - Generate ~8% average CPU (45s stress @ 95% / 525s total cycle)
# - Use minimal memory (150MB for 10s every 525s)
# - Create gentle network activity (~100 KB/s max during stress)
# - Not interfere with gaming traffic (low priority, traffic shaping)
# - Keep at least one metric above 15% threshold
#
# ============================================================================
