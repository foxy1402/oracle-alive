# ============================================================================
# Oracle Cloud Keep-Alive Configuration v2.2
# PARALLEL STRESS EDITION - FULLY OPTIMIZED
# ============================================================================
# This version runs CPU, memory, and network stress IN PARALLEL with timing
# optimized to match Oracle's periodic monitoring methodology EXACTLY.
#
# Oracle's Reclaim Policy:
# ------------------------
# Instances are reclaimed after 7 days if ALL of these are true:
#   • CPU utilization (95th percentile) < 20%
#   • Network utilization < 20%
#   • Memory utilization < 20% (ARM instances only)
#
# CRITICAL - Oracle's Monitoring Methodology:
# -------------------------------------------
# Oracle samples metrics periodically (approximately every 60 seconds):
#
#   CPU: Measures USER + NICE time ONLY
#     - Does NOT count: system, kernel, irq, softirq, steal, iowait
#     - Counts: user-space application CPU usage
#
#   Memory: Measures actual application memory (total - available)
#     - Does NOT count: buffers, cache, kernel memory
#     - Counts: memory allocated by applications
#
#   Network: Measures total interface traffic (all applications)
#     - Counts: all TX/RX bytes on primary interface
#
# This script matches Oracle's methodology EXACTLY for all three metrics.
#
# Our Strategy (v2.2 - Fully Optimized):
# ---------------------------------------
# Target: 40% average (DOUBLE Oracle's 20% minimum) + 5% margin = 45%
#
# PARALLEL EXECUTION (96-second cycle):
# t=0s:   START all three simultaneously
#         - CPU stress: 64s at 50-68% (user-space processes only)
#         - Memory: Allocate and HOLD for 90s (application memory)
#         - Network: Continuous traffic for 90s (sustained bandwidth)
# t=64s:  CPU completes, memory/network continue (26s remaining)
# t=90s:  Memory released, network stopped
# t=96s:  Next cycle begins
#
# Oracle Monitoring Alignment:
# CPU:     67% duty (64s/96s) × 68% intensity = 45% avg (USER+NICE only) ✓
# Memory:  94% duty (90s/96s) × 45% target = 42% avg (app memory only) ✓
# Network: 94% duty (90s/96s) = sustained traffic in every 60s sample ✓
#
# ============================================================================
# • Total cycle: ~100s (64s CPU + ~35s memory/network)
# • CPU measurement: USER+NICE time only (matches Oracle's monitoring)
# • Recalibration: Adapts intensity to actual system conditions
# • Best of both worlds: Predictability + efficiency
#
# ============================================================================

# ============================================================================
# TARGET METRICS CONFIGURATION
# ============================================================================

# Target utilization levels (percentage)
# Oracle minimum: 20%, We target: 40% (double for safety)
# Recommended: Keep at 40% for all three metrics
TARGET_CPU_PERCENT=40
TARGET_MEMORY_PERCENT=40
TARGET_NETWORK_PERCENT=40

# Safety margin (percentage points above target)
# This extra buffer ensures you stay safely above even with fluctuations
# Recommended: 5% (makes actual target 45%)
SAFETY_MARGIN=5

# ============================================================================
# CPU STRESS CONFIGURATION (NEW CYCLE-BASED STRATEGY)
# ============================================================================

# CPU stress pattern: Fixed stress/sleep cycles with periodic recalibration
# 
# IMPORTANT - Total Cycle Time Calculation:
# ==========================================
# Each full cycle includes:
#   1. CPU stress: 64 seconds at configured intensity
#   2. CPU sleep: 0 seconds (memory/network stress provides the "rest" period)
#   3. Memory stress: ~10-15 seconds (intelligent gap-based)
#   4. Network stress: ~20-30 seconds (intelligent gap-based)
#   5. Recalibration scan (every 12th cycle): +10 seconds
#
# Total cycle time: ~64 + 0 + 12 + 25 = ~100 seconds per cycle
# 
# Target Math:
# ============
# We want 40% average CPU over the ENTIRE cycle (including memory/network time).
# - Formula: (stress_duration × stress_intensity) / total_cycle_time = 40%
# - With 64s stress in 100s cycle: (64 × intensity) / 100 = 40%
# - Required intensity: 40 × 100 / 64 = 62.5%
#
# Strategy:
# - Start with 50% intensity (conservative)
# - Recalibration will measure actual average (likely 30-35%)
# - Auto-adjusts upward to 60-65% to hit 40% target
# - Floor constraint ensures never below 40% intensity
#
# Duty cycle: 64s / 100s = 64% of time in CPU stress
#             36% of time in memory/network (provides cooling)

# Enable CPU stress (1=enabled, 0=disabled)
STRESS_CPU=1

# Initial CPU stress intensity (percentage)
# This is the CPU usage percentage during the stress phase
# Default: 50% (recalibration will adjust to ~62% based on actual measurements)
CPU_STRESS_PERCENT=50

# CPU stress duration (seconds)
# How long to run at CPU_STRESS_PERCENT during each cycle
# Default: 64 seconds (optimized for 100s total cycle with memory/network)
CPU_STRESS_DURATION=64

# CPU sleep duration (seconds)
# How long to idle (0% CPU) after CPU stress phase, before memory/network
# Default: 0 seconds (memory/network stress provides sufficient rest period)
# Note: Set to 5-10s if you want explicit cooling time between CPU and memory stress
CPU_SLEEP_DURATION=0

# CPU recalibration interval (cycles)
# Every N cycles, scan actual system CPU and recalculate target intensity
# Default: 12 cycles (~1200 seconds = 20 minutes with 100s cycles)
CPU_RECALIBRATION_CYCLES=12

# CPU stress floor (percentage)
# Minimum stress intensity even if recalculation suggests lower
# Prevents downward drift and maintains safety buffer
# Default: 40% (matches target, ensures Oracle protection)
CPU_STRESS_FLOOR=40

# CPU stress workers (auto-detected if empty)
# Leave empty to automatically use all CPU cores
# Manual override: Set to specific number (e.g., "2")
CPU_WORKERS=""

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Monitoring interval (seconds)
# How often to re-measure and adjust memory/network stress levels
# CPU self-calibrates every CPU_RECALIBRATION_CYCLES
# Recommended: 300 (5 minutes) - balances responsiveness with efficiency
MONITORING_INTERVAL=300

# Baseline measurement duration (seconds)
# How long to observe system before applying stress
# Longer = more accurate baseline, but delays initial stress
# Recommended: 60 seconds
BASELINE_DURATION=60

# ============================================================================
# MEMORY STRESS CONFIGURATION  
# ============================================================================

# Enable memory stress (1=enabled, 0=disabled)
# ARM instances: Set to 1 (memory is monitored)
# x86 instances: Can set to 0 (memory not monitored by Oracle)
STRESS_MEMORY=1

# Maximum memory to allocate (MB)
# Script will allocate UP TO this much to reach target
# It intelligently calculates actual need based on baseline
# Memory is allocated once and HELD for entire cycle (90s)
# This ensures Oracle's periodic samples always see the target percentage
# Recommended: 150-500MB depending on total RAM
MEMORY_STRESS_MB=500

# Memory/Network parallel duration (seconds)
# How long to hold memory and run continuous network traffic
# Both run in parallel with CPU stress and continue after CPU completes
# Default: 90 seconds (ensures 94% duty cycle for Oracle's periodic sampling)
MEMORY_NETWORK_DURATION=90

# ============================================================================
# NETWORK STRESS CONFIGURATION (GAMING VPN OPTIMIZED)
# ============================================================================

# Enable network stress (1=enabled, 0=disabled)
# Set to 1 to ensure network reaches target
STRESS_NETWORK=1

# Network stress mode
# "smart" = Gaming-friendly, bandwidth-controlled (RECOMMENDED)
NETWORK_STRESS_MODE="smart"

# Network bandwidth limit (KB/s)
# Maximum bandwidth to use during stress
# Script will use UP TO this amount to reach target
# Recommended: 100-500 KB/s (0.8-4 Mbps)
# Note: Script intelligently calculates actual need
NETWORK_BANDWIDTH_LIMIT_KBS=500

# Use distributed targets
# Spreads network traffic across multiple providers
NETWORK_USE_DISTRIBUTED_TARGETS=1

# Ping targets (space-separated)
# Multiple DNS providers for distributed traffic
NETWORK_PING_TARGETS="8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 208.67.222.222 208.67.220.220"

# Pings per target per cycle
NETWORK_PINGS_PER_TARGET=5

# Ping interval (seconds)
NETWORK_PING_INTERVAL=0.3

# HTTP targets (space-separated URLs)
# Small HTTP requests to generate traffic
NETWORK_HTTP_TARGETS="http://www.google.com/generate_204 http://detectportal.firefox.com/success.txt http://captive.apple.com/hotspot-detect.html https://www.cloudflare.com/cdn-cgi/trace"

# HTTP requests per cycle
NETWORK_HTTP_REQUESTS=10

# HTTP timeout (seconds)
NETWORK_HTTP_TIMEOUT=3

# Enable download test
# Downloads small files to generate measurable bandwidth
NETWORK_ENABLE_DOWNLOAD_TEST=1

# Download test URL
NETWORK_DOWNLOAD_TEST_URL="http://speedtest.ftp.otenet.gr/files/test100k.db"

# Traffic shaping (requires iproute2 package)
# Prioritizes your VPN/gaming traffic over keep-alive traffic
NETWORK_USE_TRAFFIC_SHAPING=1

# Traffic priority (0-7, where 7 is lowest)
NETWORK_TRAFFIC_PRIORITY=7

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log file location
LOG_FILE=/var/log/oracle-keep-alive.log

# Log level (DEBUG, INFO, WARN, ERROR)
# DEBUG: Very verbose, shows all calculations and decisions
# INFO: Normal operation, shows metrics and stress applied
# WARN: Only warnings and errors
# ERROR: Only errors
LOG_LEVEL=INFO

# Statistics logging interval (in cycles)
# Shows comprehensive stats every N cycles
# Set to 0 to disable
# Recommended: 6 (approximately every 30-60 minutes)
LOG_STATS_EVERY_N_CYCLES=6

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Process priority (nice level)
# 19 = lowest priority (won't interfere with your services)
PROCESS_NICE_LEVEL=19

# IO scheduling class
# idle = lowest priority for disk I/O
IO_SCHEDULING_CLASS=idle

# ============================================================================
# HOW THE NEW CYCLE-BASED CPU SYSTEM WORKS
# ============================================================================
#
# Example Scenario (PARALLEL EXECUTION):
# ---------------------------------------
# Your instance is running WireGuard VPN for gaming
#
# Initial state:
#   • Baseline CPU: 5% (WireGuard encryption, USER+NICE only)
#   • Baseline Memory: 10% (WireGuard + OS, application memory only)
#   • Baseline Network: 150 KB/s (gaming traffic)
#
# Target: 45% (40% target + 5% margin) on all metrics
#
# CYCLE EXECUTION (96 seconds total):
# ====================================
# t=0s: Cycle start
#   - Memory: Allocate 8.4GB (35% of 24GB) → total 45% ✓
#   - Network: Start continuous 500 KB/s traffic
#   - CPU: Start stress at 50% intensity (all in parallel)
#
# t=64s: CPU stress completes
#   - CPU contributed: (50% × 64s) / 96s = 33% average
#   - Memory: Still holding 45% (continues)
#   - Network: Still transmitting 500 KB/s (continues)
#
# t=90s: Memory and network complete
#   - Memory: Release 8.4GB
#   - Network: Stop traffic
#   - Memory contributed: (45% × 90s) / 96s = 42% average ✓
#   - Network contributed: (500 KB/s × 90s) / 96s = 468 KB/s avg ✓
#
# t=96s: Cleanup done, next cycle begins
#
# RECALIBRATION (after cycle 12, ~20 minutes):
#   - Scans actual USER CPU: 33% (baseline 5% + stress 28%)
#   - Target: 45%
#   - Gap: 12%
#   - Calculates: Need (45% × 96s) / 64s = 68% intensity
#   - Adjusts: CPU stress 50% → 68%
#
# AFTER RECALIBRATION:
#   - CPU: (68% × 64s) / 96s = 45% average ✓
#   - Memory: (45% × 90s) / 96s = 42% average ✓
#   - Network: Continuous 500 KB/s for 94% of time ✓
#
# Result:
#   ALL THREE metrics above 40% minimum
#   Oracle's 60s periodic samples ALWAYS catch elevated metrics
#   Measurements match Oracle's methodology EXACTLY
#
# ============================================================================

# ============================================================================
# GAMING VPN OPTIMIZATION NOTES
# ============================================================================
#
# This cycle-based version is EXCELLENT for gaming VPNs because:
#
# 1. Predictable CPU Pattern:
#    - Fixed 50% for 32s, sleep 48s = no surprise spikes
#    - You know exactly when stress happens (every 80 seconds)
#    - Can schedule around it or adjust timing if needed
#
# 2. Resource Cooling:
#    - 48-second sleep allows CPU/memory to cool down
#    - Prevents sustained high temperatures
#    - Better for long-term hardware health
#
# 3. Dynamic Adaptation:
#    - Recalibrates every 16 minutes based on actual usage
#    - If gaming causes high CPU, stress reduces automatically
#    - If idle, stress increases to maintain target
#
# 4. Floor Constraint:
#    - Never drops below 40% stress intensity
#    - Prevents downward drift over time
#    - Ensures Oracle protection is always active
#
# 5. Respects Your Existing Traffic:
#    - Memory/Network still use intelligent gap-based approach
#    - Measures what you're already using
#    - Only adds what's needed to reach targets
#
# 6. Triple Protection:
#    - Ensures ALL THREE metrics are safe (not just one)
#    - 40% target = double Oracle's 20% minimum
#    - 5% safety margin = extra buffer for fluctuations
#
# Recommended Settings for Gaming VPN (PARALLEL OPTIMIZED):
# -----------------------------------------------------------
# TARGET_CPU_PERCENT=40
# TARGET_MEMORY_PERCENT=40
# TARGET_NETWORK_PERCENT=40
# SAFETY_MARGIN=5
# CPU_STRESS_PERCENT=50               # Initial (recalibrates to ~68%)
# CPU_STRESS_DURATION=64              # Stress phase (64s)
# CPU_SLEEP_DURATION=0                # No sleep (parallel with memory/network)
# MEMORY_NETWORK_DURATION=90          # Hold memory/run network for 90s
# CPU_RECALIBRATION_CYCLES=12         # Recalibrate every ~20 min
# CPU_STRESS_FLOOR=40                 # Minimum stress intensity
# NETWORK_BANDWIDTH_LIMIT_KBS=500     # Max network bandwidth
# MONITORING_INTERVAL=300             # Memory/network check interval
#
# These settings deliver:
#   ✓ All metrics above 40% (double Oracle minimum)
#   ✓ PARALLEL execution (96s cycles: 64s CPU + 32s mem/net overlap)
#   ✓ High duty cycles (67% CPU, 94% memory/network)
#   ✓ USER-only CPU measurement (matches Oracle, excludes system/kernel)
#   ✓ Application memory only (matches Oracle, excludes buffers/cache)
#   ✓ Continuous network traffic (ensures Oracle samples catch it)
#   ✓ Recalibrates CPU every ~20 min to maintain 45% average
#   ✓ Floor prevents downward drift (never below 40%)
#   ✓ Gaming-friendly (nice=19, traffic shaping, predictable pattern)
#
# ============================================================================

# ============================================================================
# MONITORING TIPS
# ============================================================================
#
# After Installation:
# -------------------
# 1. Watch the initial startup:
#    sudo tail -f /var/log/oracle-keep-alive.log
#    
#    You'll see:
#    [INFO] Starting parallel stress cycles...
#    [INFO] CPU: 50% for 64s
#    [INFO] Memory/Network: Hold for 90s (parallel with CPU)
#    [INFO] Total cycle: ~96s (90s stress + 6s cleanup)
#    [INFO] === Cycle #1 ===
#    [INFO] Memory stress: Allocating XXXmb, holding for 90s (parallel)
#    [INFO] Network stress: Continuous XXX KB/s for 90s (parallel)
#    [INFO] CPU Cycle #1: 50% for 64s, sleep 0s (expect 33% avg)
#    [INFO] CPU stress phase: Running at 50% for 64s
#    [INFO] CPU stress phase completed (64s)
#    [INFO] CPU done (64s), waiting 26s for memory/network to complete...
#    [INFO] Memory stress completed (held for 90s)
#    [INFO] Network stress completed (ran for 90s)
#
# 2. Watch for recalibration (after ~20 minutes / 12 cycles):
#    [INFO] === CPU Recalibration (after 12 cycles) ===
#    [INFO] Scanning actual system CPU usage...
#    [INFO] Current actual CPU usage: 33% (USER+NICE only, excludes system/kernel)
#    [INFO] Target (with buffer): 45%
#    [INFO] Gap to target: 12%
#    [INFO] Duty cycle: 67% (64s/96s total cycle)
#    [INFO] Calculated stress intensity: 68%
#    [INFO] New CPU stress intensity: 68%
#
# 3. Verify parallel execution and Oracle methodology:
#    - All three metrics elevated SIMULTANEOUSLY
#    - CPU measured: USER + NICE only (top %us + %ni)
#    - Memory measured: Application memory only (free: total - available)
#    - Network measured: Total interface traffic (continuous)
#    - Oracle samples (~60s): ALWAYS catch elevated metrics
#
# 4. Check Oracle Cloud Console after 1 hour:
#    Compute → Instances → Metrics
#    
#    CPU: ~45% average with 96s cycle pattern (67% duty cycle)
#    Memory: ~42% average, held continuously (94% duty cycle)
#    Network: Sustained activity throughout (94% duty cycle)
#
# Troubleshooting:
# ----------------
# • If CPU not reaching target (check after 1 hour):
#   - Verify STRESS_CPU=1
#   - Check logs for recalibration messages
#   - Increase CPU_STRESS_PERCENT to 60-70%
#   - Reduce CPU_SLEEP_DURATION to 40s (increases duty cycle)
#   - Ensure CPU_STRESS_FLOOR is at least 40%
#
# • If CPU too high (above 60% average):
#   - Reduce CPU_STRESS_PERCENT to 40-45%
#   - Increase CPU_SLEEP_DURATION to 56s (reduces duty cycle)
#   - Script will auto-adjust down during recalibration
#
# • If experiencing VPN lag:
#   - Reduce CPU_STRESS_PERCENT to 45%
#   - Reduce CPU_STRESS_DURATION to 24s
#   - Increase CPU_SLEEP_DURATION to 56s
#   - This gives more cooling time between bursts
#
# • If Memory not reaching target:
#   - Increase MEMORY_STRESS_MB to 1000
#   - Check available RAM: free -h
#
# • If Network not reaching target:
#   - Increase NETWORK_BANDWIDTH_LIMIT_KBS to 1000
#   - Ensure network interface is detected correctly
#
# • If gaming lag detected:
#   - Reduce NETWORK_BANDWIDTH_LIMIT_KBS to 200
#   - Reduce CPU_STRESS_PERCENT to 40
#   - Install iproute2 for traffic shaping
#   - Set LOG_LEVEL=DEBUG to see detailed metrics
#
# • To verify CPU recalibration is working:
#   - Set LOG_LEVEL=INFO
#   - Wait for 12 cycles (16 minutes)
#   - Look for "CPU Recalibration" messages in logs
#   - Should show: actual usage, target, new intensity
#
# ============================================================================
