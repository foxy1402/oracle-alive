[Unit]
Description=Oracle Cloud Keep-Alive Service v2.0 (Gaming VPN Optimized)
Documentation=https://github.com/YOUR_USERNAME/oracle-alive
After=network-online.target
Wants=network-online.target
# Start after WireGuard if it exists
After=wg-quick@wg0.service
# Start after OpenVPN if it exists
After=openvpn@server.service

[Service]
Type=simple
ExecStart=/opt/oracle-keep-alive/keep-alive.sh

# Restart policy - always restart on failure
Restart=always
RestartSec=30

# Standard output/error to journal
StandardOutput=journal
StandardError=journal

# Syslog identifier
SyslogIdentifier=oracle-keep-alive

# Run as root (needed for memory stress and traffic shaping)
# TODO: Consider creating dedicated user for better security
User=root
Group=root

# Environment variables from config file
EnvironmentFile=-/etc/default/oracle-keep-alive

# Resource limits
# Nice level for low CPU priority (gaming traffic comes first)
Nice=19

# IO scheduling - idle class (gaming I/O comes first)
IOSchedulingClass=idle
IOSchedulingPriority=7

# Limit maximum memory usage to prevent runaway allocation
# This is a safety limit - actual usage is controlled by MEMORY_STRESS_MB
MemoryMax=512M
MemoryHigh=256M

# Process limits
LimitNOFILE=1024
LimitNPROC=128

# Security hardening
# Prevent privilege escalation
NoNewPrivileges=true

# Restrict access to /proc and /sys
ProtectProc=invisible
ProcSubset=pid

# Make /home, /root, and /run/user inaccessible
ProtectHome=true

# Make various system directories read-only
ProtectSystem=strict

# Allow writing to /var/log for log files
ReadWritePaths=/var/log

# Allow access to /dev/shm for memory stress
ReadWritePaths=/dev/shm

# Prevent writing to system directories
ReadOnlyPaths=/etc
ReadOnlyPaths=/opt/oracle-keep-alive

# Network access - needed for ping and HTTP requests
RestrictAddressFamilies=AF_INET AF_INET6

# Allow binding to any port (though we don't actually bind)
RestrictNetworkInterfaces=

# No need for system calls that could be dangerous
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Kill all processes in cgroup on stop
KillMode=mixed
KillSignal=SIGTERM

# Timeout for start/stop
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
