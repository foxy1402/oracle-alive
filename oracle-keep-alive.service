[Unit]
Description=Oracle Cloud Keep-Alive Service v2.2 (Parallel Stress Edition)
Documentation=https://github.com/foxy1402/oracle-alive
After=network-online.target
Wants=network-online.target
# Start after WireGuard if it exists (optional dependency)
After=wg-quick@wg0.service
# Start after OpenVPN if it exists (optional dependency)
After=openvpn@server.service

[Service]
Type=simple
ExecStart=/opt/oracle-keep-alive/keep-alive.sh

# Restart policy - always restart on failure
Restart=always
RestartSec=30

# Standard output/error to journal
StandardOutput=journal
StandardError=journal

# Syslog identifier
SyslogIdentifier=oracle-keep-alive

# Run as root (needed for memory stress and traffic shaping)
User=root
Group=root

# Environment variables from config file
EnvironmentFile=-/etc/default/oracle-keep-alive

# Resource limits
# Nice level for low CPU priority (gaming traffic comes first)
Nice=19

# IO scheduling - idle class (gaming I/O comes first)
# Note: IOSchedulingClass=idle requires systemd 240+, using best-effort as fallback
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Process limits
LimitNOFILE=1024
LimitNPROC=128

# Security hardening (compatible with systemd 239+ on Oracle Linux 8 and Ubuntu 20.04+)
# Prevent privilege escalation
NoNewPrivileges=true

# Make /home, /root, and /run/user inaccessible
ProtectHome=true

# Make various system directories read-only
# Note: Using 'full' instead of 'strict' to allow reading /etc/default/oracle-keep-alive
# 'full' protects /usr and /boot (read-only) but allows reading /etc
ProtectSystem=full

# Allow writing to /var/log for log files
ReadWritePaths=/var/log

# Allow access to /dev/shm for memory stress
ReadWritePaths=/dev/shm

# Note: ProtectProc and ProcSubset require systemd 247+, not available on Oracle Linux 8
# The script needs access to /proc/stat and /proc/meminfo for monitoring

# Network access - needed for ping and HTTP requests
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# System call filtering (basic set compatible with older systemd)
SystemCallArchitectures=native

# Kill all processes in cgroup on stop
KillMode=mixed
KillSignal=SIGTERM

# Timeout for start/stop
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
