# ============================================================================
# Oracle Cloud Fixed-Mode Keep-Alive Configuration
# ============================================================================
#
# This file configures the fixed-mode keep-alive script that maintains
# EXACT target percentages continuously (no sleep cycles).
#
# After editing, restart the service:
#   sudo systemctl restart oracle-fixed-mode
#
# ============================================================================

# ============================================================================
# TARGET UTILIZATION (CUSTOMIZE THESE!)
# ============================================================================

# Set your desired utilization targets (percentage)
# Oracle's minimum is 20%, recommend 25-35% for safety margin
#
# IMPORTANT: These are the exact percentages you want to maintain 24/7
# The script will continuously adjust to keep metrics at these levels
#
TARGET_CPU_PERCENT=25
TARGET_MEMORY_PERCENT=30
TARGET_NETWORK_PERCENT=30

# ============================================================================
# CONTROL PARAMETERS
# ============================================================================

# How often to check and adjust metrics (seconds)
# Lower = more responsive but more overhead
# Recommended: 3-5 seconds for stable control
CONTROL_INTERVAL=3

# How much to adjust per cycle (prevents overcorrection)
CPU_ADJUSTMENT_STEP=5          # Percentage points
MEMORY_ADJUSTMENT_MB=100       # Megabytes
NETWORK_ADJUSTMENT_KBS=50      # Kilobytes per second

# Tolerance - acceptable deviation from target (prevents thrashing)
# If current usage is within target ± tolerance, no adjustment is made
CPU_TOLERANCE=2                # Percentage points
MEMORY_TOLERANCE=2             # Percentage points  
NETWORK_TOLERANCE=3            # Percentage points

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Maximum network bandwidth to use (KB/s)
# Safety limit to prevent saturating your connection
NETWORK_BANDWIDTH_LIMIT_KBS=500

# DNS servers for network traffic (distributed targets)
NETWORK_TARGETS="8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1"

# ============================================================================
# LOGGING
# ============================================================================

# Log file location
LOG_FILE=/var/log/oracle-fixed-mode.log

# Log level: DEBUG, INFO, WARN, ERROR
# DEBUG = verbose, INFO = normal, WARN = warnings only, ERROR = errors only
LOG_LEVEL=INFO

# How often to log status reports (seconds)
STATS_INTERVAL=60

# ============================================================================
# PROCESS PRIORITY
# ============================================================================

# Nice level (0-19, higher = lower priority)
# 19 = lowest priority (stress won't interfere with user apps)
PROCESS_NICE_LEVEL=19

# I/O scheduling class
# idle = lowest I/O priority
IO_SCHEDULING_CLASS=idle

# ============================================================================
# NOTES
# ============================================================================
#
# Single-CPU Optimization:
# - CPU stress is automatically capped at 95% to prevent total lockup
# - The script uses proportional control to prevent overshoot
# - You can safely set TARGET_CPU_PERCENT=25 on a 1-CPU instance
#
# Memory Safety:
# - Memory allocation is capped at 90% of total RAM to prevent OOM
# - Uses /dev/shm for fast in-memory allocation
#
# Network Bandwidth:
# - Traffic is distributed across multiple DNS targets
# - All processes run at lowest priority (nice 19)
# - NETWORK_BANDWIDTH_LIMIT_KBS prevents saturation
#
# Oracle's Reclaim Policy:
# - Instances are reclaimed after 7 days if ALL metrics < 20%
# - This script maintains ALL metrics at your configured targets
# - Recommended targets: 25-35% (25-75% above Oracle's minimum)
#
# Monitoring:
# - Check Oracle Cloud Console → Metrics after 1 hour
# - All three graphs should show stable horizontal lines
# - View logs: sudo tail -f /var/log/oracle-fixed-mode.log
#
