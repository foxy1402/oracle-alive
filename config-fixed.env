# ============================================================================
# Oracle Cloud Fixed-Mode Keep-Alive Configuration
# ============================================================================
# After editing, restart the service:
#   sudo systemctl restart oracle-fixed-mode
# ============================================================================

# ============================================================================
# TARGET UTILIZATION — THE ONLY VALUES YOU NEED TO SET
# ============================================================================

# Keep CPU above this percentage 24/7
# Oracle's minimum is 20%; 25-30% gives a safe margin
TARGET_CPU_PERCENT=25

# Keep RAM above this percentage 24/7
# Oracle's minimum is 20%; 25-30% gives a safe margin
TARGET_MEMORY_PERCENT=30

# ============================================================================
# LOGGING
# ============================================================================

LOG_FILE=/var/log/oracle-fixed-mode.log
LOG_LEVEL=INFO
STATS_INTERVAL=60

# ============================================================================
# ADVANCED — defaults are fine for most users
# ============================================================================

# How often to check and adjust metrics (seconds)
CONTROL_INTERVAL=3

# Network stress — disabled by default
# Uncomment both lines to activate network stress
# ENABLE_NETWORK=true
# TARGET_NETWORK_PERCENT=30
